# ==============================================================================
# ValorantHub — variables de entorno
# Copia este archivo a .env y rellena los valores. .env nunca se commitea
# (ver .gitignore).
# ==============================================================================

# ---- PostgreSQL (match-service, recommendation-engine, coaching-platform) ----
POSTGRES_DB=valoranthub
POSTGRES_USER=valoranthub
POSTGRES_PASSWORD=changeme_postgres
# "localhost" mientras los microservicios corren en el host (./mvnw
# spring-boot:run) contra el Postgres de docker-compose (puerto publicado).
# Cambiar a "postgres" cuando el propio servicio se dockerice y se una a
# valorant-backend-net (docker-compose.yml no lo incluye todavía).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis (cache, pub/sub de WebSocket, rate limiting del Gateway) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_redis

# ---- Kafka / Zookeeper (event-driven pipeline de análisis) ------------------
KAFKA_BROKER=kafka:29092
KAFKA_EXTERNAL_BROKER=localhost:9092
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181

# ---- MongoDB (resultados de análisis de ai-analysis-service) ----------------
MONGO_INITDB_ROOT_USERNAME=valoranthub
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo
MONGO_URI=mongodb://valoranthub:changeme_mongo@mongo:27017/valoranthub?authSource=admin

# ---- Riot Games API -----------------------------------------------------------
# Dev key: expira cada 24h, renovar en developer.riotgames.com.
RIOT_API_KEY=
# regional-routing (ACCOUNT-V1, cross-game): americas | europe | asia
RIOT_REGIONAL_ROUTING=americas
# platform-routing (VAL-MATCH-V1/VAL-CONTENT-V1): na | eu | ap | kr | latam | br
RIOT_PLATFORM_ROUTING=na

# ---- Proveedores LLM ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Seguridad ------------------------------------------------------------------
# Secreto HS256 para firmar JWT (coaching-platform). Genera uno con:
# openssl rand -base64 64
JWT_SECRET=changeme_jwt_secret_at_least_256_bits_long
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Perfiles Spring -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
